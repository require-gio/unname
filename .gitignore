# ---------------------------------------------------------------------------
app/src-tauri/target/
office-engine/target*/
app/src-tauri/gen/
**/*.rs.bk

# ---------------------------------------------------------------------------
# Modelle und Modelldaten (werden beim Bundling geholt, nicht versioniert)
# ---------------------------------------------------------------------------
# Ignore model data only; source directories named models/ stay versioned.
/sidecar/models/
*.onnx
*.safetensors
*.bin
*.pt
*.pth
tessdata/

# ---------------------------------------------------------------------------
# Personenbezogene Daten - gehoeren NIEMALS ins Repository
# ---------------------------------------------------------------------------
master-data/*
!master-data/.gitkeep
!master-data/*.example.csv
!master-data/README.md

# Token-Tresor, Secrets, Auditlog
*.secret
secret.key
vault.sqlite*
audit.sqlite*

# Job-Daten und Exporte
jobs/
exports/
diagnose/

# ---------------------------------------------------------------------------
# Betriebssystem / Werkzeuge
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Portables Tesseract und GLiNER-Snapshot (scripts/tesseract-portable.py)
/.bundle-inputs/

# Vision-Helfer (macOS)
vision-ocr/.build/
vision-ocr/.swiftpm/
download-xpc/.build/
download-xpc/.swiftpm/

# Upload-Ordner der Modellspiegel (scripts/models/modelle.py spiegel)
modelle-upload/
