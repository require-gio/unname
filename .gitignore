# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml
sidecar/bundle-assets/
sidecar/.pyinstaller/
app/src-tauri/binaries/*
!app/src-tauri/binaries/.gitkeep

# ---------------------------------------------------------------------------
